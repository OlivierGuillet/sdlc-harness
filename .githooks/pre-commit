#!/usr/bin/env bash
# Validate the marketplace and the plugin before every commit.
# Enabled by dotfiles/install.sh (git config core.hooksPath .githooks).
# Bypass once with: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v claude >/dev/null 2>&1; then
  echo "pre-commit: 'claude' not found in PATH, skipping plugin validation" >&2
  exit 0
fi

status=0
for target in . plugins/harness-sdlc; do
  if ! out="$(claude plugin validate "$target" --strict 2>&1)"; then
    echo "pre-commit: claude plugin validate $target --strict failed:" >&2
    printf '%s\n' "$out" >&2
    status=1
  fi
done

[ "$status" -eq 0 ] && echo "pre-commit: marketplace and plugin valid (--strict)"
exit "$status"
